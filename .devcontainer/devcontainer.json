{
  // Ambiente do GitHub Codespaces: imagem "universal" (padrão do Codespaces),
  // que já traz Python e Docker para rodar "docker compose" no terminal.
  "name": "calculadora-notas",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "API calculadora-notas" }
  },
  "hostRequirements": { "cpus": 2 },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-azuretools.vscode-docker"]
    }
  }
}
