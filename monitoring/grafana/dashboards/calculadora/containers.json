      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(container_memory_working_set_bytes{servico!=\"\"} / (container_spec_memory_limit_bytes{servico!=\"\"} > 0))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true
