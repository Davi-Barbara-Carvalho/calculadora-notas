# Copie para .env e ajuste (o .env não vai para o Git).
POSTGRES_USER=calculadora
POSTGRES_PASSWORD=calculadora
POSTGRES_DB=calculadora
API_PORT=8000
# APP_IMAGE=ghcr.io/davi-barbara-carvalho/calculadora-notas:latest

# Monitoramento
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
CADVISOR_PORT=8080
MAILPIT_PORT=8025

# Alertas por e-mail: por padrão vão para o Mailpit (http://localhost:8025).
# Para receber de verdade, use um SMTP real (ex.: Gmail com senha de app):
# SMTP_HOST=smtp.gmail.com:587
# SMTP_USER=seu.email@gmail.com
# SMTP_PASSWORD=senha-de-app
# SMTP_FROM=seu.email@gmail.com
ALERTA_EMAIL=equipe@calculadora.local
